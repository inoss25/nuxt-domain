{
  "name": "nuxt-domain",
  "version": "0.3.0",
  "description": "Architecture domain-driven pour Nuxt : routes, i18n et auto-imports par domaine",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inoss25/nuxt-domain.git"
  },
  "bugs": {
    "url": "https://github.com/inoss25/nuxt-domain/issues"
  },
  "homepage": "https://github.com/inoss25/nuxt-domain#readme",
  "keywords": [
    "nuxt",
    "nuxt-module",
    "ddd",
    "domain-driven",
    "i18n",
    "routes"
  ],
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts"
    }
  },
  "main": "./index.ts",
  "types": "./index.ts",
  "files": [
    "index.ts",
    "module.ts",
    "types.ts",
    "shared/runtime",
    "pages/index.ts",
    "pages/module.ts",
    "pages/runtime",
    "i18n/index.ts",
    "i18n/module.ts",
    "i18n/runtime",
    "docs/GUIDE.md",
    "CHANGELOG.md",
    "scripts/create-domain.mjs",
    "README.md"
  ],
  "bin": {
    "create-domain": "scripts/create-domain.mjs"
  },
  "scripts": {
    "create-domain": "node ./scripts/create-domain.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark": "node ./scripts/benchmark.mjs"
  },
  "dependencies": {
    "fast-glob": "^3.3.3",
    "jiti": "^2.7.0"
  },
  "peerDependencies": {
    "@nuxtjs/i18n": ">=8.0.0",
    "nuxt": ">=3.12.0"
  },
  "devDependencies": {
    "@nuxt/schema": "^4.5.2",
    "nuxt": "^4.5.2",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
