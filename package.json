{
  "name": "nuxt-domain",
  "version": "0.5.0",
  "description": "Domain-driven architecture for Nuxt: routes, i18n and auto-imports per domain",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inoss25/nuxt-domain.git"
  },
  "bugs": {
    "url": "https://github.com/inoss25/nuxt-domain/issues"
  },
  "homepage": "https://github.com/inoss25/nuxt-domain#readme",
  "keywords": [
    "nuxt",
    "nuxt-module",
    "ddd",
    "domain-driven",
    "i18n",
    "routes"
  ],
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md",
    "scripts/create-domain.mjs",
    "README.md",
    "README.fr.md"
  ],
  "bin": {
    "create-domain": "scripts/create-domain.mjs"
  },
  "scripts": {
    "build": "nuxt-module-build build",
    "prepack": "nuxt-module-build build",
    "create-domain": "node ./scripts/create-domain.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "benchmark": "node ./scripts/benchmark.mjs",
    "dev": "nuxi dev playground",
    "dev:prepare": "nuxi prepare playground",
    "dev:build": "nuxi build playground",
    "dev:typecheck": "nuxi typecheck playground"
  },
  "dependencies": {
    "@nuxtjs/i18n": "^10.6.0",
    "consola": "^3.4.2",
    "fast-glob": "^3.3.3",
    "jiti": "^2.7.0"
  },
  "peerDependencies": {
    "nuxt": "^3.19.0 || >=4.1.0"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.2",
    "@types/node": "^24.19.2",
    "nuxt": "^4.5.2",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.3.13"
  }
}
